{
  "name": "ytx-downloader-gui",
  "version": "1.0.0",
  "description": "Modern Electron desktop GUI for yt-dlp downloads.",
  "main": "src/main.js",
  "private": true,
  "type": "commonjs",
  "author": "YTX",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "dist": "npm run fetch-binaries && electron-builder --win",
    "dist:portable": "npm run fetch-binaries && electron-builder --win portable",
    "pack": "npm run fetch-binaries && electron-builder --dir",
    "fetch-binaries": "node scripts/fetch-binaries.js"
  },
  "build": {
    "appId": "com.ytx.downloader",
    "productName": "YTX Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "tokens/**/*",
      "_ds_bundle.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
