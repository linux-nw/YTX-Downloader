{
  "name": "ytx-downloader-gui",
  "version": "1.0.0",
  "description": "Modern Electron desktop GUI for yt-dlp downloads.",
  "main": "src/main.js",
  "private": true,
  "type": "commonjs",
  "author": "YTX",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.ytx.downloader",
    "productName": "YTX Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "tokens/**/*",
      "_ds_bundle.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  }
}
